# 复制成 .env 后填值。.env 已在 .gitignore 里，不要提交。
#
# 写法规矩（这几条都是踩过坑的）：
#   - 注释单独占一行，不要写在值后面
#   - 等号两边不留空格
#   - 值不要加引号
#   .env 里 `KEY= value  # 注释` 这种写法 python-dotenv 会把空格和注释一起吃进值里。

# --- 基础设施 ---
# 本机开发：localhost:5433（docker compose 把容器 5432 映到宿主 5433，
# 因为本机另有一个 PG18 占着 5432）
# 容器内：主机名要写服务名 postgres:5432 —— compose 里已覆盖，不用改这个文件
DATABASE_URL=postgresql+asyncpg://shopping:shopping123@localhost:5433/shopping
REDIS_URL=redis://localhost:6379/0
APP_ENV=dev

# --- 认证 ---
# 必须换成真随机值：python -c "import secrets; print(secrets.token_urlsafe(48))"
# PyJWT 对短于 32 字节的 HMAC key 会发 InsecureKeyLengthWarning
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- 大模型 ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 向量 ---
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 换 embedding 模型是昂贵操作：要全量重嵌 + 改 Vector(1024) 列宽 + 重建 HNSW 索引。
# 所以维度写在这里，模型名也写在这里，别散落在代码里。
EMBEDDING_DIM=1024

# --- 可选调参（不写就用 config.py 里的默认值）---
# ORDER_PAY_TIMEOUT_MINUTES=30
# FAQ_SIMILARITY_THRESHOLD=0.59
# LOGIN_RATE_LIMIT=10
# SCHEDULER_ENABLED=false
